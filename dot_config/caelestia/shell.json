        "id": "lockStatus",
        "enabled": true
      },
      {
        "id": "audio",
        "enabled": true
      },
      {
        "id": "microphone",
        "enabled": true
      },
      {
        "id": "network",
        "enabled": true
      },
      {
        "id": "bluetooth",
        "enabled": true
      },
      {
        "id": "battery",
        "enabled": true
      }
