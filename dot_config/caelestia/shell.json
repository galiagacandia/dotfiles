{
  "appearance": {
    "transparency": {
      "enabled": true
    }
  },
  "background": {
    "enabled": true,
    "visualiser": {
      "autoHide": true,
      "enabled": true
    },
    "wallpaperEnabled": true
  },
  "bar": {
    "clock": {
      "showDate": true,
      "showIcon": true
    },
    "persistent": true,
    "showOnHover": true,
    "statusIcons": [
      {
        "enabled": true,
        "id": "lockStatus"
      },
      {
        "enabled": true,
        "id": "audio"
      },
      {
        "enabled": true,
        "id": "microphone"
      },
      {
        "enabled": true,
        "id": "network"
      },
      {
        "enabled": true,
        "id": "bluetooth"
      },
      {
        "enabled": true,
        "id": "battery"
      }
    ],
    "workspaces": {
      "activeIndicator": true,
      "activeLabel": "",
      "displayType": "Text",
      "label": "",
      "occupiedLabel": "",
      "perMonitor": true,
      "showWindows": true,
      "shown": 5
    }
  },
  "dashboard": {
    "enabled": true,
    "showMedia": true,
    "showPerformance": true,
    "showWeather": true
  },
  "general": {
    "apps": {
      "audio": [
        "pavucontrol"
      ],
      "explorer": [
        "dolphin"
      ],
      "playback": [
        "mpv"
      ],
      "terminal": [
        "ghostty",
        "-e"
      ]
    },
    "idle": {
      "inhibitWhenAudio": true,
      "lockBeforeSleep": true,
      "timeouts": [
        {
          "enabled": true,
          "idleAction": "lock",
          "inhibitWhenAudio": true,
          "inhibitWhenCharging": false,
          "respectInhibitors": true,
          "timeout": 600
        },
        {
          "enabled": true,
          "idleAction": "dpms off",
          "inhibitWhenAudio": false,
          "inhibitWhenCharging": false,
          "respectInhibitors": true,
          "returnAction": "dpms on",
          "timeout": 900
        }
      ]
    }
  },
  "launcher": {
    "enabled": true,
    "vimKeybinds": false
  },
  "lock": {
    "enableFprint": false,
    "enableHowdy": false,
    "enabled": true,
    "useWallpaper": true
  },
  "notifs": {
    "expire": true,
    "fullscreen": "On"
  },
  "osd": {
    "enableBrightness": true,
    "enableMicrophone": true,
    "enabled": true
  },
  "paths": {
    "wallpaperDir": "~/Pictures"
  },
  "services": {
    "audioIncrement": 0.05,
    "brightnessIncrement": 0.05,
    "clockFormat": "TwentyFourHour",
    "defaultPlayer": "Spotify",
    "weatherLocation": "La Paz"
  },
  "session": {
    "enabled": true
  },
  "sidebar": {
    "enabled": true
  },
  "utilities": {
    "enabled": true,
    "quickToggles": [
      {
        "enabled": true,
        "id": "wifi"
      },
      {
        "enabled": true,
        "id": "bluetooth"
      },
      {
        "enabled": true,
        "id": "mic"
      },
      {
        "enabled": true,
        "id": "settings"
      },
      {
        "enabled": true,
        "id": "gameMode"
      },
      {
        "enabled": true,
        "id": "dnd"
      },
      {
        "enabled": false,
        "id": "vpn"
      }
    ]
  }
}
