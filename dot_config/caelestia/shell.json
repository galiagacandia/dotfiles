{
  "general": {
    "apps": {
      "terminal": [
        "ghostty",
        "-e"
      ],
      "explorer": [
        "dolphin"
      ],
      "playback": [
        "mpv"
      ],
      "audio": [
        "pavucontrol"
      ]
    },
    "idle": {
      "lockBeforeSleep": true,
      "inhibitWhenAudio": true,
      "timeouts": [
        {
          "timeout": 600,
          "idleAction": "lock",
          "inhibitWhenAudio": true,
          "respectInhibitors": true
        },
        {
          "timeout": 900,
          "idleAction": "dpms off",
          "returnAction": "dpms on"
        }
      ]
    }
  },
  "background": {
    "enabled": true,
    "wallpaperEnabled": true,
    "visualiser": {
      "enabled": true,
      "autoHide": true
    }
  },
  "bar": {
    "persistent": true,
    "showOnHover": true,
    "clock": {
      "showDate": true,
      "showIcon": true
    },
    "statusIcons": [
